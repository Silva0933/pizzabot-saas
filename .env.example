# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua_anon_key_publica"

# Evolution API (WhatsApp)
VITE_EVOLUTION_API_URL="http://seu-servidor:8080"
VITE_EVOLUTION_API_KEY="sua_api_key_evolution"

# n8n callbacks (workflows ativos no n8n server)
VITE_N8N_STATUS_WEBHOOK_URL="https://n8nai.secretariaai.eu.cc/webhook/pizzabot-status"
VITE_N8N_PAYMENT_WEBHOOK_URL="https://n8nai.secretariaai.eu.cc/webhook/pizzabot-pagamento"
VITE_N8N_RAG_WEBHOOK_URL="https://n8nai.secretariaai.eu.cc/webhook/pizzabot-rag-finalizar"
VITE_N8N_THANKS_WEBHOOK_URL="https://n8nai.secretariaai.eu.cc/webhook/pizzabot-agradecimento"
VITE_N8N_SECRETARIA_WEBHOOK_URL="https://n8nai.secretariaai.eu.cc/webhook/pizzabot-secretaria"
