{
  "name": "PizzaBot - Processar Pagamento",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "pizzabot-payment",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "d7f2f813-7df9-456a-9e51-e0cf16b52a01",
      "name": "Webhook Gerar Pagamento",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -720,
        0
      ],
      "webhookId": "pizzabot-payment"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst totalValue = Number(body.totalValue ?? 0);\nconst gateway = String(body.gateway ?? '').toLowerCase();\n\nif (!body.orderId || !body.customerName || totalValue <= 0) {\n  return [{ json: { ok: false, error: 'missing_order_customer_or_value', body } }];\n}\n\nif (body.paymentMethod !== 'pix') {\n  return [{ json: { ok: false, error: 'only_pix_is_enabled_in_this_workflow', body } }];\n}\n\nif (gateway !== 'asaas') {\n  return [{ json: { ok: false, error: 'gateway_not_enabled_for_payment_workflow', gateway, body } }];\n}\n\nconst dueDate = new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString().slice(0, 10);\nconst description = `PizzaBot pedido #${body.orderNumber || body.orderId} - ${body.customerName}`;\n\nreturn [{\n  json: {\n    ok: true,\n    gateway,\n    orderId: body.orderId,\n    orderNumber: body.orderNumber,\n    customerName: body.customerName,\n    customerPhone: String(body.customerPhone ?? '').replace(/\\D/g, ''),\n    value: Number(totalValue.toFixed(2)),\n    dueDate,\n    description,\n    externalReference: body.orderId\n  }\n}];"
      },
      "id": "4b480e9e-85c6-44f4-a0da-5856ab5a7901",
      "name": "Validar Pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -500,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "8a17efdd-3e6a-4429-9bb1-b5ce05ca8d01",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "45591e63-02ad-4681-8b9d-4d9222584201",
      "name": "Payload OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -280,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.ASAAS_API_URL || 'https://sandbox.asaas.com/api/v3').replace(/\\/$/, '') + '/payments' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "access_token",
              "value": "={{ $env.ASAAS_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"customer\": \"{{ $env.ASAAS_CUSTOMER_ID }}\",\n  \"billingType\": \"PIX\",\n  \"value\": {{ $json.value }},\n  \"dueDate\": \"{{ $json.dueDate }}\",\n  \"description\": \"{{ $json.description }}\",\n  \"externalReference\": \"{{ $json.externalReference }}\"\n}",
        "options": {}
      },
      "id": "0ce087f2-f7c7-4d94-adfe-0c43df029701",
      "name": "Criar Cobrança Asaas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -20,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "const payment = $json;\nreturn [{\n  json: {\n    ok: true,\n    paymentId: payment.id,\n    paymentStatus: String(payment.status ?? 'PENDING').toLowerCase() === 'received' ? 'approved' : 'pending',\n    paymentLink: payment.invoiceUrl || payment.bankSlipUrl || payment.transactionReceiptUrl || '',\n    gatewayResponse: payment\n  }\n}];"
      },
      "id": "3164c7e7-f7fe-4907-86be-125779a16801",
