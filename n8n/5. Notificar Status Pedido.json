    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst message = String(body.message ?? '').trim();\nconst phone = String(body.customerPhone ?? '').replace(/\\D/g, '');\nconst instance = String(body.instance ?? '').trim();\n\nif (!message || !phone || !instance) {\n  return [{ json: { skip: true, reason: 'missing_message_phone_or_instance', body } }];\n}\n\nreturn [{\n  json: {\n    skip: false,\n    instance,\n    phone,\n    text: message,\n    status: body.status,\n    orderId: body.orderId,\n    orderNumber: body.orderNumber,\n    pizzeriaId: body.pizzeriaId\n  }\n}];"
      },
