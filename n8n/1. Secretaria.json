      ],
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst data = body.data ?? body;\nconst key = data.key ?? body.key ?? {};\nconst msg = data.message ?? body.message ?? {};\nconst text =\n  msg.conversation ??\n  msg.extendedTextMessage?.text ??\n  msg.imageMessage?.caption ??\n  msg.videoMessage?.caption ??\n  body.text ??\n  body.messageText ??\n  '';\nconst remoteJid = key.remoteJid ?? body.remoteJid ?? body.from ?? body.sender ?? data.sender ?? '';\nconst phone = String(remoteJid).replace(/@.+$/, '').replace(/\\D/g, '');\nconst instance = String(body.instance ?? body.instanceName ?? data.instance ?? '').trim();\nconst fromMe = Boolean(key.fromMe ?? body.fromMe ?? false);\nconst isGroup = String(remoteJid).includes('@g.us');\n\nreturn [{ json: {\n  raw: body,\n  instance,\n  phone,\n  messageId: key.id ?? body.id ?? body.messageId ?? 'msg-' + Date.now(),\n  text: String(text || '').trim(),\n  fromMe,\n  isGroup,\n  receivedAt: new Date().toISOString()\n}}];"
      }
