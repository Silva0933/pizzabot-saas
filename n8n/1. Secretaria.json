    {
      "id": "10000000-0000-4000-8000-000000000010",
      "name": "Montar contexto IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const tenantCtx = $('Preparar tenant').first().json;\nconst tenant = tenantCtx.tenant;\nconst input = tenantCtx.input;\nconst customer = (Array.isArray($('Upsert cliente').first().json) ? $('Upsert cliente').first().json[0] : $('Upsert cliente').first().json) || {};\nconst conversation = (Array.isArray($('Buscar conversa').first().json) ? $('Buscar conversa').first().json[0] : $('Buscar conversa').first().json) || null;\nconst products = Array.isArray($('Buscar card?pio').first().json) ? $('Buscar card?pio').first().json : [];\n\nif (conversation && conversation.bot_ativo === false) {\n  return [{ json: { skip: true, reason: 'bot_inactive_for_conversation', tenant, input, customer, conversation, products } }];\n}\n\nconst menu = products.map(p => `- [${p.id}] ${p.nome} (${p.categoria}) R$ ${Number(p.preco).toFixed(2)}: ${p.descricao || ''}`).join('\\n') || 'Nenhum item dispon?vel no momento.';\nconst history = (customer.historico_pedidos || []).slice(-10);\nconst systemPrompt = `${tenant.prompt_personalizado || 'Voc? ? o PizzaBot, atendente de uma pizzaria.'}\\n\\nREGRAS IMPORTANTES:\\n- Responda sempre em portugu?s brasileiro.\\n- Use apenas itens dispon?veis no card?pio.\\n- Se o cliente confirmar um pedido, retorne JSON v?lido com order.confirmed=true.\\n- Se ainda estiver conversando, retorne order.confirmed=false.\\n- paymentMethod deve ser pix, cartao ou dinheiro.\\n- deliveryType deve ser delivery ou retirada.\\n- items deve conter productId, name, qty, priceUnit e observation opcional.\\n\\nCLIENTE:\\nNome: ${customer.nome || 'n?o informado'}\\nTelefone: ${input.phone}\\nEndere?o padr?o: ${customer.endereco_padrao || 'n?o informado'}\\nPrefer?ncias: ${customer.preferencias || 'sem prefer?ncias'}\\nHist?rico: ${JSON.stringify(history)}\\n\\nCARD?PIO DISPON?VEL:\\n${menu}\\n\\nResponda SOMENTE JSON neste formato:\\n{\\\"reply\\\":\\\"mensagem ao cliente\\\",\\\"customer\\\":{\\\"name\\\":\\\"nome se informado\\\",\\\"address\\\":\\\"endere?o se confirmado\\\",\\\"preferences\\\":\\\"prefer?ncias percebidas\\\"},\\\"order\\\":{\\\"confirmed\\\":false,\\\"deliveryType\\\":\\\"delivery\\\",\\\"address\\\":\\\"\\\",\\\"paymentMethod\\\":\\\"pix\\\",\\\"notes\\\":\\\"\\\",\\\"items\\\":[]}}`;\n\nreturn [{ json: {\n  skip: false,\n  tenant, input, customer, conversation, products,\n  geminiPayload: {\n    contents: [{ role: 'user', parts: [{ text: systemPrompt + '\\n\\nMENSAGEM DO CLIENTE: ' + input.text }] }],\n    generationConfig: { temperature: 0.3, responseMimeType: 'application/json' }\n  }\n}}];"
      }
