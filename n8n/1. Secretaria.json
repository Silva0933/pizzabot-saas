    {
      "id": "10000000-0000-4000-8000-000000000013",
      "name": "Interpretar resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        -80
      ],
      "parameters": {
        "jsCode": "const ctx = $('Montar contexto IA').first().json;\nconst raw = $json.candidates?.[0]?.content?.parts?.[0]?.text || '';\nlet parsed;\ntry {\n  parsed = JSON.parse(raw.replace(/^```json\\s*/i, '').replace(/```$/i, '').trim());\n} catch {\n  parsed = { reply: raw || 'Desculpe, n?o consegui processar sua mensagem agora.', order: { confirmed: false, items: [] }, customer: {} };\n}\nconst order = parsed.order || { confirmed: false, items: [] };\nconst items = Array.isArray(order.items) ? order.items.map(item => ({\n  productId: item.productId || null,\n  name: item.name,\n  qty: Number(item.qty || 1),\n  priceUnit: Number(item.priceUnit || 0),\n  observation: item.observation || ''\n})).filter(item => item.name && item.qty > 0) : [];\nconst total = items.reduce((sum, item) => sum + item.qty * item.priceUnit, 0);\nconst messages = [ ...(ctx.conversation?.messages || []),\n  { id: ctx.input.messageId, sender: 'client', content: ctx.input.text, timestamp: ctx.input.receivedAt },\n  { id: 'bot-' + Date.now(), sender: 'bot', content: parsed.reply || '', timestamp: new Date().toISOString() }\n];\nreturn [{ json: { ...ctx, ai: parsed, reply: parsed.reply || '', order: { ...order, items, totalValue: Number(total.toFixed(2)) }, messages } }];"
      }
    },
