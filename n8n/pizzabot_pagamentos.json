        -320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.mercadopago.com/v1/payments",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.mp_access_token }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"transaction_amount\": {{ $json.valor_total }},\n  \"description\": \"Pedido #{{ $json.numero_pedido }} - {{ $json.pizzaria_nome }}\",\n  \"payment_method_id\": \"pix\",\n  \"external_reference\": \"{{ $json.id }}\",\n  \"payer\": {\n    \"first_name\": \"{{ $json.cliente_nome }}\",\n    \"email\": \"cliente+{{ $json.cliente_telefone }}@pizzabot.local\"\n  }\n}",
        "options": {}
      },
      "id": "p07_mp",
      "name": "MercadoPago Cobrança",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        20,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normaliza retorno dos dois gateways em formato ?nico\nconst pedido = $('Carregar Pedido').first().json;\nconst resp = $json;\n\nlet paymentId = '', paymentLink = '', pixCopiaCola = '';\nif (resp.id && resp.invoiceUrl) {\n  // Asaas\n  paymentId = String(resp.id);\n  paymentLink = resp.invoiceUrl || resp.bankSlipUrl || '';\n  pixCopiaCola = resp.pix?.payload || resp.encodedImage || '';\n} else if (resp.id) {\n  // MercadoPago\n  paymentId = String(resp.id);\n  paymentLink = resp.point_of_interaction?.transaction_data?.ticket_url || '';\n  pixCopiaCola = resp.point_of_interaction?.transaction_data?.qr_code || '';\n}\n\nconst hasLinkOrPix = Boolean(paymentLink || pixCopiaCola);\nreturn [{\n  json: {\n    ok: hasLinkOrPix,\n    error: hasLinkOrPix ? '' : 'Gateway retornou cobran?a sem link/PIX. Verifique credenciais e ambiente do provedor.',\n    pedido_id: pedido.id,\n    pizzaria_id: pedido.pizzaria_id,\n    telefone: pedido.cliente_telefone,\n    instancia: pedido.instancia,\n    payment_id: paymentId,\n    payment_link: paymentLink,\n    pix_copia_cola: pixCopiaCola,\n    numero_pedido: pedido.numero_pedido,\n    valor_total: pedido.valor_total\n  }\n}];"
      },
      "id": "p08_norm",
      "name": "Normalizar Resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        250,
        -200
      ]
    },
