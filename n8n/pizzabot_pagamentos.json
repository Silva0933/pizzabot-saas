    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\": true, \"received\": true}",
        "options": {}
      },
      "id": "p16_resp_conf",
      "name": "Resposta Confirmação",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -200,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const pedido = $json;\nif (pedido.error || pedido.message || !pedido.id) {\n  return [{ json: { ...pedido, payment_config_ok: false, payment_error: 'Pedido pendente nao encontrado para este telefone/pizzaria.' } }];\n}\nconst gateway = String(pedido.gateway_pagamento || 'nenhum').toLowerCase().trim();\nconst rawPaymentMethod = String(pedido.forma_pagamento || 'pix').toLowerCase().trim();\nconst paymentAliases = { pix: 'pix', '3': 'pix', cartao: 'cartao', 'cart?o': 'cartao', '2': 'cartao', dinheiro: 'dinheiro', '1': 'dinheiro' };\nconst paymentMethod = paymentAliases[rawPaymentMethod] || 'pix';\nconst asaasKey = String(pedido.asaas_api_key || '').trim();\nconst mpKey = String(pedido.mp_access_token || '').trim();\n\nlet error = '';\nif (!['pix', 'cartao'].includes(paymentMethod)) {\n  error = 'Forma de pagamento nao exige link automatico.';\n} else if (gateway === 'asaas' && !asaasKey) {\n  error = 'Gateway Asaas selecionado, mas a API Key nao esta configurada.';\n} else if (gateway === 'mercadopago' && !mpKey) {\n  error = 'Gateway MercadoPago selecionado, mas o Access Token nao esta configurado.';\n} else if (!['asaas', 'mercadopago'].includes(gateway)) {\n  error = 'Nenhum gateway de pagamento automatico configurado para esta pizzaria.';\n}\n\nreturn [{ json: { ...pedido, forma_pagamento: paymentMethod, gateway_pagamento: gateway, payment_config_ok: !error, payment_error: error } }];"
      },
