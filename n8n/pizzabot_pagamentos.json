        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"customer\": \"{{ $('Asaas Cliente').item.json.id }}\",\n  \"billingType\": \"PIX\",\n  \"value\": {{ $('Carregar Pedido').item.json.valor_total }},\n  \"dueDate\": \"{{ $now.plus({days:1}).toFormat('yyyy-MM-dd') }}\",\n  \"description\": \"Pedido #{{ $('Carregar Pedido').item.json.numero_pedido }} - {{ $('Carregar Pedido').item.json.pizzaria_nome }}\",\n  \"externalReference\": \"{{ $('Carregar Pedido').item.json.id }}\"\n}",
        "options": {}
      },
      "id": "p06_asaas",
      "name": "Asaas Cobrança",
