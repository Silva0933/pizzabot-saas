    {
      "parameters": {
        "resource": "messages-api",
        "operation": "send-text",
        "instanceName": "={{ $('Normalizar Resposta').item.json.instancia }}",
        "remoteJid": "={{ $('Normalizar Resposta').item.json.telefone }}",
        "messageText": "=💳 *Pagamento do Pedido #{{ $('Normalizar Resposta').item.json.numero_pedido }}*\n\nValor: R$ {{ $('Normalizar Resposta').item.json.valor_total }}\n\n🔗 Link de pagamento:\n{{ $('Normalizar Resposta').item.json.payment_link }}\n\n📋 PIX copia-e-cola:\n```\n{{ $('Normalizar Resposta').item.json.pix_copia_cola }}\n```\n\nAssim que o pagamento for confirmado, te aviso aqui! 🍕",
        "options_message": {}
      },
      "id": "p10_send",
      "name": "Enviar Link ao Cliente",
      "type": "n8n-nodes-evolution-api.evolutionApi",
      "typeVersion": 1,
      "position": [
        700,
        -200
      ],
      "credentials": {
        "evolutionApi": {
          "id": "OfPUfZENlrzqKq0v",
          "name": "Evolution API"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\": true, \"paymentId\": \"{{ $('Normalizar Resposta').item.json.payment_id }}\", \"paymentLink\": \"{{ $('Normalizar Resposta').item.json.payment_link }}\"}",
        "options": {}
      },
      "id": "p11_resp",
      "name": "Resposta Geração",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        920,
        -200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Aceita formatos de Asaas e MercadoPago\nconst body = $json.body ?? $json;\nlet pedidoExternalRef = '', status = '', paymentId = '';\n\nif (body.event && body.payment) {\n  // Asaas: { event: 'PAYMENT_RECEIVED', payment: { id, status, externalReference, value } }\n  paymentId = String(body.payment.id || '');\n  pedidoExternalRef = String(body.payment.externalReference || '');\n  const evt = String(body.event).toUpperCase();\n  if (evt.includes('RECEIVED') || evt.includes('CONFIRMED')) status = 'approved';\n  else if (evt.includes('REFUND') || evt.includes('DELETED') || evt.includes('CANCELED')) status = 'cancelled';\n  else status = 'pending';\n} else if (body.action || body.type) {\n  // MercadoPago: { action, data: { id }, type: 'payment' }\n  paymentId = String(body.data?.id || body.resource || '');\n  // Para MP precisamos do externalReference no payload completo (alguns webhooks já enviam, outros não)\n  pedidoExternalRef = String(body.external_reference || body.data?.external_reference || '');\n  status = body.action === 'payment.updated' ? 'approved' : 'pending';\n}\n\nreturn [{\n  json: {\n    skip: !pedidoExternalRef && !paymentId,\n    pedido_id: pedidoExternalRef,\n    payment_id: paymentId,\n    payment_status: status\n  }\n}];"
      },
      "id": "p12_parse_webhook",
      "name": "Parsear Webhook Gateway",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1000,
        200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE public.pedidos SET payment_status = $1, status = CASE WHEN $1 = 'approved' THEN 'confirmado' ELSE status END, updated_at = NOW() WHERE (id::text = $2 OR payment_id = $3) RETURNING id, pizzaria_id, cliente_id, numero_pedido, valor_total, status, payment_status, (SELECT telefone FROM public.clientes WHERE id = pedidos.cliente_id) AS cliente_telefone, (SELECT instancia FROM public.pizzarias WHERE id = pedidos.pizzaria_id) AS instancia, (SELECT mensagens_status FROM public.pizzarias WHERE id = pedidos.pizzaria_id) AS mensagens_status;",
        "options": {
          "queryReplacement": "={{ $json.payment_status }},{{ $json.pedido_id }},{{ $json.payment_id }}"
        }
      },
