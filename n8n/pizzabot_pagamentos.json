    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst pedidoIdRaw = String(body.pedido_id || body.orderId || '').trim();\nconst pedido_id = pedidoIdRaw || '__missing__';\nconst pizzaria_id = String(body.pizzaria_id || body.pizzeriaId || '').trim();\nconst telefone = String(body.telefone || body.customerPhone || '').replace(/\\D/g, '');\n\nif (!pizzaria_id) {\n  throw new Error('pizzaria_id e obrigatorio');\n}\nif (pedido_id === '__missing__' && !telefone) {\n  throw new Error('Informe pedido_id ou telefone para localizar o pedido pendente');\n}\n\nreturn [{ json: { pedido_id, has_pedido_id: pedido_id !== '__missing__', pizzaria_id, telefone, instancia: body.instancia || body.instance || '' } }];"
      },
      "id": "p03_validate",
      "name": "Validar Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1000,
        -200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT p.id, p.pizzaria_id, p.numero_pedido, p.valor_total, p.cliente_id, p.forma_pagamento, p.itens, p.endereco_entrega, c.nome AS cliente_nome, c.telefone AS cliente_telefone, pz.gateway_pagamento, pz.asaas_api_key, pz.mp_access_token, pz.nome AS pizzaria_nome, pz.instancia\nFROM public.pedidos p\nJOIN public.clientes c ON c.id = p.cliente_id\nJOIN public.pizzarias pz ON pz.id = p.pizzaria_id\nWHERE p.pizzaria_id = $2\n  AND (\n    ($1 <> '__missing__' AND p.id::text = $1)\n    OR ($1 = '__missing__' AND regexp_replace(c.telefone, '\\D', '', 'g') = $3 AND p.payment_status = 'pending' AND p.status <> 'cancelado')\n  )\nORDER BY p.created_at DESC\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{ $json.pedido_id }},{{ $json.pizzaria_id }},{{ $json.telefone }}"
        }
      },
      "id": "p04_load",
      "name": "Carregar Pedido",
