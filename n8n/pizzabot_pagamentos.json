      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE public.pedidos SET payment_id = $1, link_pagamento = $2, payment_status = 'pending', updated_at = NOW() WHERE id = $3 RETURNING id;",
        "options": {
          "queryReplacement": "={{ $json.payment_id }},{{ $json.payment_link }},{{ $json.pedido_id }}"
        }
      },
      "id": "p09_update",
      "name": "Atualizar Pedido",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
