# ============================================
# PizzaBot Backend — Variaveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA comite o .env no Git.

# --- App ---
APP_ENV=development                   # development | staging | production
APP_PORT=8000
APP_SECRET_KEY=troque-isso-em-producao-com-string-aleatoria-de-64-chars
CORS_ORIGINS=http://localhost:5173,https://painel.seu-dominio.com

# --- Banco de Dados (Postgres no Coolify) ---
DATABASE_URL=postgresql+asyncpg://pizzabot:senha_forte@postgres:5432/pizzabot
DATABASE_URL_SYNC=postgresql://pizzabot:senha_forte@postgres:5432/pizzabot

# --- Redis (fila e cache) ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=60
JWT_REFRESH_TOKEN_TTL_DAYS=30

# --- Integracoes externas ---
# Evolution API (WhatsApp)
EVOLUTION_BASE_URL=http://evolution.secretariaai.eu.cc
EVOLUTION_API_KEY=lSAG0e6P4B12JAgS00MIpJsDzYIRd80Q

# Gemini (IA — provider padrão)
GEMINI_API_KEY=

# OpenRouter (alternativa multi-modelo: use LLM_PROVIDER=openrouter)
# Obtenha sua chave em https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenAI (alternativa direta: use LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Configuração do LLM via env (opcional — o painel admin tem precedência via banco)
# Defina estas variáveis para usar OpenRouter com GPT-4o-mini:
#   LLM_PROVIDER=openrouter
#   LLM_MODEL=openai/gpt-4o-mini
LLM_PROVIDER=
LLM_MODEL=

# Mercado Pago — validacao da assinatura do webhook dos PEDIDOS.
# No MP o secret e POR APLICACAO, e cada pizzaria usa a aplicacao dela, entao o
# valor correto fica em pizzarias.mp_webhook_secret (cadastrado no painel, em
# Meu Negocio > Pagamento). Este aqui e so fallback para quem nao cadastrou.
# Vazio = assinatura nao verificada (o webhook ainda consulta o pagamento na API
# do MP antes de aplicar, mas preencher e o recomendado em producao).
MP_WEBHOOK_SECRET=

# --- Cobranca da PLATAFORMA (assinatura mensal das pizzarias via Asaas) ---
# OPCIONAL: estes tres campos agora tambem sao editaveis no painel, em
# Administracao > Planos > Gateway de cobranca, e o que esta salvo la tem
# PRIORIDADE sobre o que estiver aqui. Estas variaveis viram o fallback.
# Sem chave (nem aqui nem no painel) nenhuma pizzaria assina nem paga — e a
# suspensao automatica por inadimplencia fica desligada de proposito, pra nao
# trancar a base inteira sem saida.
# Conta Asaas do DONO da plataforma (nao confundir com as chaves por pizzaria).
ASAAS_PLATFORM_API_KEY=
# Token de autenticacao do webhook (Asaas -> Integracoes -> Webhooks).
ASAAS_PLATFORM_WEBHOOK_TOKEN=
# Sandbox para testes: https://api-sandbox.asaas.com/v3
ASAAS_PLATFORM_BASE_URL=https://api.asaas.com/v3

# --- Observabilidade ---
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                       # json | text
# Sentry (erros com stack trace). Vazio = desligado. Crie um projeto em sentry.io
# e cole o DSN aqui (vale para API, worker e beat).
SENTRY_DSN=
