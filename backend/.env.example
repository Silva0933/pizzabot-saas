# ============================================
# PizzaBot Backend — Variaveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA comite o .env no Git.

# --- App ---
APP_ENV=development                   # development | staging | production
APP_PORT=8000
APP_SECRET_KEY=troque-isso-em-producao-com-string-aleatoria-de-64-chars
CORS_ORIGINS=http://localhost:5173,https://painel.seu-dominio.com

# --- Banco de Dados (Postgres no Coolify) ---
DATABASE_URL=postgresql+asyncpg://pizzabot:senha_forte@postgres:5432/pizzabot
DATABASE_URL_SYNC=postgresql://pizzabot:senha_forte@postgres:5432/pizzabot

# --- Redis (fila e cache) ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=60
JWT_REFRESH_TOKEN_TTL_DAYS=30

# --- Integracoes externas ---
# Evolution API (WhatsApp)
EVOLUTION_BASE_URL=http://evolution.secretariaai.eu.cc
EVOLUTION_API_KEY=lSAG0e6P4B12JAgS00MIpJsDzYIRd80Q

# Gemini (IA)
GEMINI_API_KEY=

# Mercado Pago (chave global de plataforma para webhook validation)
MP_WEBHOOK_SECRET=

# --- Observabilidade ---
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                       # json | text
